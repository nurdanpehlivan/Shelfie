<?xml version="1.0" encoding="utf-8"?>
<!-- The account file holds the sync session token and this install's id; neither may follow
     the data to another device (see AccountStore). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/account.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/account.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
